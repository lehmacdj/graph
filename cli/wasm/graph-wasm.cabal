cabal-version: 3.0
name:          graph-wasm
version:       0.1.0.0
synopsis:      The path parser, syntax feedback and completion, for wasm
description:
  The modules of the graph library (../src) that parsing a path, its
  syntax problems and completion without a graph need, built with
  ghc-wasm-meta into a WebAssembly reactor that exports them to
  JavaScript (src/Main.hs). See ../docs/wasm.md.
license:       BSD-3-Clause
author:        Devin Lehmacher
maintainer:    lehmacdj@gmail.com
build-type:    Simple

-- The blocks between the BEGIN and END lines are generated by
-- sync-cabal.py (build.sh runs it): the extensions and options from
-- ../package.yaml, and the modules that src imports, transitively.
-- Edit the rest by hand.

executable graph
  main-is:          Main.hs
  hs-source-dirs:   src ../src
  default-language: Haskell2010
  ghc-options:
    -no-hs-main -optl-mexec-model=reactor
    "-optl-Wl,--export=parsePath,--export=complete"
  build-depends:
    , aeson
    , attoparsec
    , base
    , base-orphans
    , bytestring
    , classy-prelude
    , comonad
    , constraints
    , containers
    , deepseq
    , effectful
    , effectful-core
    , effectful-th
    , generic-data
    , generic-lens
    , ghc-experimental
    , hspec
    , hspec-expectations
    , ixset-typed
    , lens
    , lens-regex-pcre
    , megaparsec
    , modern-uri
    , mono-traversable
    , mtl
    , ordered-containers
    , parser-combinators
    , pcre-light
    , profunctors
    , QuickCheck
    , random
    , semigroupoids
    , tasty
    , tasty-golden
    , tasty-hspec
    , tasty-hunit
    , tasty-quickcheck
    , template-haskell
    , text
    , time
    , vary

  -- BEGIN generated by sync-cabal.py
  default-extensions:
    BangPatterns
    BlockArguments
    CApiFFI
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveAnyClass
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveLift
    DeriveTraversable
    DerivingStrategies
    DerivingVia
    DisambiguateRecordFields
    DuplicateRecordFields
    FlexibleContexts
    FlexibleInstances
    FunctionalDependencies
    GADTs
    GeneralizedNewtypeDeriving
    ImportQualifiedPost
    ImpredicativeTypes
    LambdaCase
    LexicalNegation
    MultiParamTypeClasses
    NamedFieldPuns
    NoFieldSelectors
    NoImplicitPrelude
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    PatternSynonyms
    PolyKinds
    QuantifiedConstraints
    QuasiQuotes
    RankNTypes
    RecordWildCards
    RoleAnnotations
    ScopedTypeVariables
    StandaloneDeriving
    StandaloneKindSignatures
    StrictData
    TemplateHaskellQuotes
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    TypeSynonymInstances
    ViewPatterns
  ghc-options:
    -Wall
    -flate-specialise
    -fspecialise-aggressively
  cpp-options:
    -DDEBUG
  other-modules:
    Graph.SystemNodes
    Models.Command
    Models.Command.Parse
    Models.Common
    Models.Completion
    Models.Connect
    Models.Edge
    Models.Graph
    Models.LegacyPartialPath
    Models.NID
    Models.Node
    Models.Path
    Models.Path.Parse
    Models.Path.ParsedPath
    Models.Path.PartialPath
    Models.Path.Simple
    Models.PathPattern
    Models.PathPattern.Compile
    MyPrelude
    MyPrelude.Collections
    MyPrelude.Collections.Ordered
    MyPrelude.Conc
    MyPrelude.EarlyReturn
    MyPrelude.Effect
    MyPrelude.Function
    MyPrelude.FunctorClasses
    MyPrelude.IO
    MyPrelude.JSON
    MyPrelude.MaybeEither
    MyPrelude.MonadApplicative
    MyPrelude.Orphans
    MyPrelude.RawStrings
    MyPrelude.Regex
    MyPrelude.Time
    MyPrelude.Type
    MyPrelude.URI
    MyPrelude.Vary
    Utils.Base62
    Utils.Parsing
    Utils.Parsing.Common
    Utils.Parsing.Problems
    Utils.Testing
    Utils.Testing.External
    Wasm.Api
  -- END generated by sync-cabal.py
